# Snipe-IT Shared Environment Configuration
# Point all scripts here, instead of hardcoding individually


# Snipe-IT API Credentials
export SNIPE_URL="URL"
export SNIPE_API_KEY="TOKEN"

# SMTP / Email Settings
export SMTP_SERVER="smtp.domain.com"
export SMTP_PORT="000"
export SMTP_USER="email@domain.com"
export SMTP_PASS="Password"
export EMAIL_FROM="sender@domain.com" # This can match SMTP_USER
export EMAIL_TO="distro@domain.com"
